---
import SiteLayout from '../layouts/SiteLayout.astro';
import Editorial from '../components/Editorial.astro';

const water = [
  ['Water access and availability studies', 'Map water sources, review collection time and seasonal shortages, and compare available supply with demand.'],
  ['Water supply and sanitation infrastructure assessments', 'Review reticulation, storage, pipework, sanitation facilities and maintenance needs.'],
  ['Borehole and groundwater consultancy', 'Coordinate specialist siting investigations, review drilling and pump-test records, and identify groundwater monitoring needs.'],
];
const research = [
  ['Utility performance and customer experience', 'Assess reliability, affordability, satisfaction, metering and payment practices to identify service improvement priorities.'],
  ['Community surveys and stakeholder research', 'Design household and institutional surveys, map stakeholders, and document the priorities and experiences of different groups.'],
  ['Gender and social inclusion assessments', 'Examine how gaps in essential services affect different groups and, where commissioned, assess barriers to workforce participation.'],
  ['Programme research and advisory', 'Bring records and field evidence together to identify gaps and recommend a practical sequence of actions.'],
];
const advisory = [
  ['Civil and structural works advisory', 'Review site conditions, access and drainage, and identify questions that need specialist assessment.'],
  ['Project planning and construction monitoring', 'Clarify scope and dependencies, document site progress, and support completion and handover planning.'],
  ['Site development and readiness', 'Review terrain, infrastructure and site constraints, then identify surveys, approvals and enabling works.'],
];
---
<SiteLayout title="Services" description="Explore Matrox’s water and sanitation assessments, groundwater advisory, utility performance reviews, community research and project monitoring services.">
  <Editorial title="Consultancy services" image="sanitation" alt="Pipework fitted along a sanitation facility" background="paper" intro>
    <p>Field research and technical advisory for water utilities, public institutions and development partners.</p>
  </Editorial>
  <section class="section" id="water"><div class="container">
    <div class="section-heading" data-reveal="rise"><span class="rule" aria-hidden="true"></span><h2>Water and sanitation</h2><p>Understand how water and sanitation services perform and where coverage, reliability and infrastructure can improve.</p></div>
    <div class="detail-list">{water.map(([name, description]) => <article data-reveal="rise"><h3>{name}</h3><p>{description}</p></article>)}</div>
  </div></section>
  <Editorial title="Research and utility performance" image="community-water" alt="Community water infrastructure" side="left" offset="up" background="paper" id="research">
    <p>Give customer and community experiences a clear place in service planning.</p>
  </Editorial>
  <section class="section"><div class="container detail-list">{research.map(([name, description]) => <article data-reveal="rise"><h3>{name}</h3><p>{description}</p></article>)}</div></section>
  <section class="section paper" id="advisory"><div class="container">
    <div class="section-heading" data-reveal="rise"><span class="rule" aria-hidden="true"></span><h2>Technical and project advisory</h2><p>Identify what needs to happen on site and keep track of decisions through delivery.</p></div>
    <div class="detail-list">{advisory.map(([name, description]) => <article data-reveal="rise"><h3>{name}</h3><p>{description}</p></article>)}</div>
  </div></section>
  <section class="section"><div class="container closing"><h2>Talk to us about your project</h2><a class="button" href="/contact-us/">Contact us</a></div></section>
</SiteLayout>
