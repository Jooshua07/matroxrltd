---
import SiteLayout from '../layouts/SiteLayout.astro';
import Editorial from '../components/Editorial.astro';
---
<SiteLayout title="About Us" description="Learn about Matrox Resources Limited, a Lusaka consultancy combining field research, community engagement and technical advisory for water and sanitation services.">
  <Editorial title="About Matrox" image="field-site" alt="Workers and equipment at a borehole project site" background="paper" offset="up" intro>
    <p>We are a Lusaka-based consultancy and research firm serving water utilities, public institutions and development partners.</p>
  </Editorial>
  <section class="section"><div class="container">
    <div class="section-heading" data-reveal="rise"><span class="rule" aria-hidden="true"></span><h2>Our vision and mission</h2></div>
    <div class="detail-list">
      <article data-reveal="rise"><h3>Vision</h3><p>Be a trusted Zambian consultancy that helps improve access to reliable water, sanitation and other essential services.</p></article>
      <article data-reveal="rise"><h3>Mission</h3><p>Help clients make informed decisions through field research, stakeholder engagement, technical advisory and clear recommendations.</p></article>
    </div>
  </div></section>
  <section class="section paper"><div class="container">
    <div class="section-heading" data-reveal="rise"><span class="rule" aria-hidden="true"></span><h2>How we work</h2></div>
    <div class="detail-list">
      <article data-reveal="rise"><h3>Integrity</h3><p>We report what we find and keep responsibilities clear.</p></article>
      <article data-reveal="rise"><h3>Professionalism</h3><p>We prepare carefully and meet the commitments we make.</p></article>
      <article data-reveal="rise"><h3>Accountability</h3><p>We keep clear records and follow up on agreed actions.</p></article>
      <article data-reveal="rise"><h3>Collaboration</h3><p>We work with clients, site teams and specialists to resolve issues.</p></article>
    </div>
  </div></section>
  <section class="section"><div class="container closing"><h2>Company profile</h2><a class="button" href="/downloads/matrox-company-profile.pdf" download>Download company profile (PDF)</a></div></section>
</SiteLayout>
